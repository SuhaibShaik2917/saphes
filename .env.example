# Saphes environment template - copy to .env and fill what you need.
# EVERY VALUE IS OPTIONAL. Saphes runs with no .env at all, using
# Tavily's free keyless search mode.

# Free key: https://tavily.com  (1,000 credits/month, no card required)
# Removes the hourly keyless limit so every response reads evidence_mode "live".
TAVILY_API_KEY=

# Only used if a Bifrost gateway is wired into the extractor seam. Not required.
BIFROST_API_KEY=

APP_ENV=development

# Server bind address for `python -m uvicorn app.main:app`
SAPHES_HOST=0.0.0.0
SAPHES_PORT=8000

# Force cached/bundled evidence only - useful when demoing on bad wifi.
# SAPHES_OFFLINE=1

# Tuning (defaults shown)
# TAVILY_TIMEOUT_SECONDS=8
# TAVILY_MAX_RESULTS=3
# SAPHES_CACHE_DIR=.saphes_cache