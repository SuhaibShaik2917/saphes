# All optional. Saphes runs with no keys at all (Tavily keyless mode).
# A free Tavily key (1,000 credits/month, no card) removes the hourly keyless cap
# and makes every response say evidence_mode: "live".
TAVILY_API_KEY=
BIFROST_API_KEY=

APP_ENV=development
SAPHES_HOST=0.0.0.0
SAPHES_PORT=8000

# Set to 1 to force the offline path (cached/bundled evidence only).
# SAPHES_OFFLINE=1
